# ─────────────────────────────────────────────────────────
#  GemmaBrowserAgent - Environment Configuration
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────

# Google / Gemini API
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-google-ai-studio-key-here

# Model selection (default: gemma-3-27b-it)
# Options: gemini-2.5-flash | gemini-2.5-pro | gemma-3-27b-it | gemma-3-12b
GEMMA_MODEL=gemma-3-27b-it

# Agent task for agent_gemma.py (leave blank for default task)
# TASK=Go to Wikipedia and summarise the history of Python

# Documentation Scraper (doc_scraper.py)
DOC_URL=https://docs.browser-use.com
MAX_PAGES=5
OUTPUT_DIR=./output

# Browser Use Core
BROWSER_USE_LOGGING_LEVEL=info
ANONYMIZED_TELEMETRY=false

# Optional fallback providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
